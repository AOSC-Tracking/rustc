[dependencies]
memchr = "2.7.4"
unicode-xid = "0.2.0"

[dependencies.unicode-properties]
default-features = false
features = ["emoji"]
version = "0.1.0"

[dev-dependencies]
expect-test = "1.4.0"

[lib]

[package]
description = "\nAutomatically published version of the package `rustc_lexer`\nin the rust-lang/rust repository from commit d2baa49a106fad06fbf6202fb6ea8a0b3d2767cc\n\nThe publishing script for this crate lives at:\nhttps://github.com/rust-analyzer/rustc-auto-publish\n"
edition = "2024"
license = "MIT / Apache-2.0"
name = "ra-ap-rustc_lexer"
repository = "https://github.com/rust-lang/rust"
version = "0.121.0"
