[dependencies]
smallvec = "1.8.1"

[dependencies.rustc_index_macros]
package = "ra-ap-rustc_index_macros"
version = "0.133.0"

[features]
nightly = []
rustc_randomized_layouts = []

[package]
description = "\nAutomatically published version of the package `rustc_index`\nin the rust-lang/rust repository from commit dfa22235d858086511bedc4acde9db1c045ffbac\n\nThe publishing script for this crate lives at:\nhttps://github.com/rust-analyzer/rustc-auto-publish\n"
edition = "2024"
license = "MIT / Apache-2.0"
name = "ra-ap-rustc_index"
repository = "https://github.com/rust-lang/rust"
version = "0.133.0"
