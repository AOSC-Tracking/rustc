[package]
name = "stringdex"
version = "0.0.5"
edition = "2024"
license = "MIT OR Apache-2.0"
repository = "https://gitlab.com/notriddle/stringdex"
description = "A suffixtree search system for static sites"

[lib]
bench = false

[features]
quickcheck = []
test_js = []

[dependencies]
stacker = "0.1.21"

[dev-dependencies]
criterion = { package = "codspeed-criterion-compat", version = "4.1.0" }
rand = "0.9.2"
rand_chacha = "0.9.0"
mutants = "0.0.3"
quickcheck = "1.0.3"

[profile.release]
overflow-checks = true
debug-assertions = true

[profile.bench]
overflow-checks = false
debug-assertions = false

[[bench]]
name = "tree_builder"
harness = false

[[bench]]
name = "write_tree"
harness = false

[[bench]]
name = "roaring_bitmap"
harness = false

[[bench]]
name = "base64"
harness = false

[[example]]
name = "dictionary"
doc-scrape-examples = true
