[dependencies]
rustc-literal-escaper = "0.0.5"

[dependencies.rustc_lexer]
package = "ra-ap-rustc_lexer"
version = "0.133.0"

[package]
description = "\nAutomatically published version of the package `rustc_parse_format`\nin the rust-lang/rust repository from commit dfa22235d858086511bedc4acde9db1c045ffbac\n\nThe publishing script for this crate lives at:\nhttps://github.com/rust-analyzer/rustc-auto-publish\n"
edition = "2024"
license = "MIT / Apache-2.0"
name = "ra-ap-rustc_parse_format"
repository = "https://github.com/rust-lang/rust"
version = "0.133.0"
[target."cfg(target_pointer_width = \"64\")".dev-dependencies.rustc_index]
default-features = false
package = "ra-ap-rustc_index"
version = "0.133.0"
