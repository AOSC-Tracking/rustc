[dependencies]
memchr = "2.7.6"
unicode-ident = "1.0.22"

[dependencies.unicode-properties]
default-features = false
features = ["emoji"]
version = "0.1.4"

[dev-dependencies]
expect-test = "1.4.0"

[lib]

[package]
description = "\nAutomatically published version of the package `rustc_lexer`\nin the rust-lang/rust repository from commit 32bd660612bf1c61bdf290a3ec643c8538b8357d\n\nThe publishing script for this crate lives at:\nhttps://github.com/rust-analyzer/rustc-auto-publish\n"
edition = "2024"
license = "MIT / Apache-2.0"
name = "ra-ap-rustc_lexer"
repository = "https://github.com/rust-lang/rust"
version = "0.165.0"
