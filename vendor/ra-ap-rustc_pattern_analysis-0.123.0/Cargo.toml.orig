[dependencies]
rustc-hash = "2.0.0"
rustc_apfloat = "0.2.0"
tracing = "0.1"

[dependencies.rustc_index]
default-features = false
package = "ra-ap-rustc_index"
version = "0.123.0"

[dependencies.smallvec]
features = ["union"]
version = "1.8.1"

[dev-dependencies]
tracing-tree = "0.3.0"

[dev-dependencies.tracing-subscriber]
default-features = false
features = ["fmt", "env-filter", "ansi"]
version = "0.3.3"

[features]
rustc = []

[package]
description = "\nAutomatically published version of the package `rustc_pattern_analysis`\nin the rust-lang/rust repository from commit 052114f0c5e8d49f62f8caba364b07017310ab09\n\nThe publishing script for this crate lives at:\nhttps://github.com/rust-analyzer/rustc-auto-publish\n"
edition = "2024"
license = "MIT / Apache-2.0"
name = "ra-ap-rustc_pattern_analysis"
repository = "https://github.com/rust-lang/rust"
version = "0.123.0"
